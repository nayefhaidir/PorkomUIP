DATABASE_URL=
AUTH_SECRET=
POSTGRES_PASSWORD=
# Set a unique value before running the seed command.
DEMO_PASSWORD="UIPDemo2026!"
# For PostgreSQL Compose, use the same password in POSTGRES_PASSWORD and DATABASE_URL_DOCKER.
# Select SQLite locally with DATABASE_URL=file:./data/uip.db.
# SQLite Compose uses file:/data/uip.db and does not need DATABASE_URL_DOCKER.
DATABASE_URL_DOCKER=
UPLOAD_DIR="./uploads"
PUBLIC_APP_URL="http://localhost:3000"
SMTP_ALLOW_PRIVATE_NETWORK=false
